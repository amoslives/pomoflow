# Optional environment variables. Nothing here is required to run the app.

# Port for the dev/prod server (server.ts). Defaults to 3000.
PORT="3000"

# Set to "true" to disable Vite HMR and file watching.
# Leave unset for normal development.
DISABLE_HMR="false"

# Sync API requests allowed per client IP per minute. Defaults to 120.
# The browser tests raise it, because every test shares one IP.
# TASKS_RATE_LIMIT="120"
